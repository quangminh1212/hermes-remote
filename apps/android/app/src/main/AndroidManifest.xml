<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talks to the Hermes API server over the network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Self-update: download a new APK and hand it to the package installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- QR scanning from the setup page served by the npm pack -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Voice: microphone for speech-to-text, speaker for reading replies.
         No foreground service or boot receiver: the app listens only while the
         user has continuous conversation switched on, in the foreground. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".HermesRemoteApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HermesRemote">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HermesRemote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Actions (Google Assistant / Claude-Fable):
                 "Hey Google, ask Hermes <anything>".
                 Assistant launches this activity with the query in an extra.
                 See res/xml/shortcuts.xml for the capability declarations.

                 Both the current action and the pre-rename one are accepted, so
                 an App Action registered against the old identity still routes
                 here after the package rename. -->
            <intent-filter>
                <action android:name="io.hermes.remote.action.ASK" />
                <action android:name="com.hermes.bridge.action.ASK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Voice-assistant hand-off: lets the Assistant (and any other
                 system voice interaction service) route a spoken request to
                 Hermes instead of only opening the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Plain deep link, so a shortcut or another app can prefill a
                 prompt: hermes://ask?query=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hermes" android:host="ask" />
            </intent-filter>

            <!-- Lets Assistant surface the app for the OPEN_APP_FEATURE BII. -->
            <meta-data
                android:name="com.android.systemui.action_assist_icon"
                android:resource="@mipmap/ic_launcher" />
        </activity>

        <!-- App Actions capability declaration (Phase B). -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <activity
            android:name=".ui.QrScanActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HermesRemote" />

        <!-- Shares the downloaded update APK with the system installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
