<?xml version="1.0" encoding="utf-8"?>
<!--
  Google Assistant / Claude-Fable App Actions capability for Hermes Remote.

  WHY THIS FILE LOOKS THE WAY IT DOES

  The Assistant cannot run Hermes' brain: Google retired third-party
  Conversational Actions in 2023, so an app can never *be* "Hey Google".
  What an app CAN do is be *reachable* by the Assistant. That is what an App
  Actions capability declares: Assistant parses the spoken request, then
  launches this app with the words attached.

  Two capabilities are declared, on purpose:

  1. custom.hermes.ASK: "Hey Google, ask Hermes <anything>".
     Free-text requests must use a CUSTOM capability. The built-in
     actions.intent.OPEN_APP_FEATURE parameter ("feature") is an *entity*
     resolved against a fixed catalog of app screens, so it cannot carry an
     arbitrary sentence. Mapping free text onto it is the usual reason an
     "ask <app>" action silently fails.

  2. actions.intent.OPEN_APP_FEATURE: "Hey Google, open Hermes".
     Kept as the plain app-opening route. Its parameter is optional here so a
     bare "open Hermes" is still a valid, matching request.

  Delivery contract honoured by AssistantIntent.fromIntent(): the text arrives
  in the "query" extra (our declaration), in android.intent.extra.TEXT (what
  Google's tooling commonly sends), or nested in a parameter bundle.

  TESTING

  The intent contract is fully testable without Play Services. From a shell:
      adb shell am start -a com.hermes.bridge.action.ASK -e query "git status"
  Full Assistant routing additionally needs Google Play Services plus a
  registered App Action (Play Console / Assistant test tool).

  AppFunctions (the newer API-36 successor) is deliberately NOT used yet: it
  requires an Early Access Program invite and the Android 16+ platform API.
  See HANDOFF.md for the upgrade path.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Primary route: free text handed to Hermes on the PC. -->
    <capability android:name="custom.hermes.ASK">
        <intent
            android:action="com.hermes.bridge.action.ASK"
            android:targetClass="com.hermes.bridge.ui.MainActivity"
            android:targetPackage="com.hermes.bridge">
            <parameter
                android:name="query"
                android:key="query"
                android:required="true" />
        </intent>
    </capability>

    <!-- Secondary route: "open Hermes" with no request attached. -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="com.hermes.bridge.action.ASK"
            android:targetClass="com.hermes.bridge.ui.MainActivity"
            android:targetPackage="com.hermes.bridge">
            <parameter
                android:name="feature"
                android:key="query"
                android:required="false" />
        </intent>
    </capability>

</shortcuts>
